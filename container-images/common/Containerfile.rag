ARG PARENT=quay.io/fedora/fedora:44
FROM $PARENT

ENV VIRTUAL_ENV="/opt/venv" \
    PATH="/opt/venv/bin:$PATH" \
    UV_NO_CACHE=1 \
    UV_NO_MANAGED_PYTHON=1

# ramalama_api_auth is imported by both scripts, not run: it lands in the same
# directory because Python puts a script's own directory on sys.path.
COPY container-images/scripts/doc2rag \
     container-images/scripts/rag_framework \
     container-images/scripts/ramalama_api_auth.py \
     /usr/bin/

RUN --mount=type=bind,target=/src,relabel=private \
    /src/container-images/scripts/build_rag.sh
